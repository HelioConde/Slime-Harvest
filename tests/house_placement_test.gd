extends Node
## Verifica que a casa inicial cabe perto do spawn, mas nunca aparece no jogador.


func _ready() -> void:
	call_deferred("_run")


func _check(ok: bool, label: String) -> bool:
	if ok:
		print("PASS house-placement: ", label)
		return true
	printerr("FAIL house-placement: ", label)
	get_tree().quit(1)
	return false


func _run() -> void:
	var world: Node2D = load("res://scenes/world/World.tscn").instantiate() as Node2D
	add_child(world)
	await get_tree().process_frame
	var house: Node2D = world.get_node("Actors/Map/HouseBuilder") as Node2D
	var player: CharacterBody2D = world.get_node("Actors/Player") as CharacterBody2D
	var grass: TileMapLayer = world.get_node("Actors/Map/grass2") as TileMapLayer
	var floor: TileMapLayer = house.get("floor_layer") as TileMapLayer
	if not _check(house != null and player != null and floor != null, "house, player and floor layer are available"):
		return

	var spawn: Vector2i = house.get("_spawn_cell")
	var range_tiles: int = int(house.get("max_spawn_distance_tiles"))
	var safe_tiles: int = int(house.get("player_build_clearance_tiles"))
	if not _check(range_tiles == 12 and safe_tiles == 1, "spawn radius and player safety margin configured"):
		return
	if not _check(String(house.call("_spawn_limit_reason", spawn + Vector2i(12, 0))).is_empty(), "distance of exactly 12 tiles allowed"):
		return
	if not _check(not String(house.call("_spawn_limit_reason", spawn + Vector2i(13, 0))).is_empty(), "outside 12-tile spawn radius blocked"):
		return
	if not _check(not String(house.call("_spawn_limit_reason", spawn + Vector2i(9, 9))).is_empty(), "diagonal outside circular radius blocked"):
		return

	var candidate: Vector2i = spawn
	var found: bool = false
	player.global_position = Vector2(9999, 9999)
	for ground_cell in grass.get_used_cells():
		var point: Vector2 = grass.to_global(grass.map_to_local(ground_cell))
		var cell: Vector2i = floor.local_to_map(floor.to_local(point))
		if String(house.call("_spawn_limit_reason", cell)) != "":
			continue
		if not bool(house.call("_has_house_space", cell)):
			continue
		var proposed: Dictionary = {cell: true}
		if String(house.call("_add_reason", cell, proposed)) == "":
			candidate = cell
			found = true
			break
	if not _check(found, "an actual green tile inside the spawn radius can be constructed"):
		return

	var point: Vector2 = floor.to_global(floor.map_to_local(candidate))
	player.global_position = point
	if not _check(String(house.call("_player_clearance_reason", candidate)).contains("personagem"), "cannot construct over player tile"):
		return
	if not _check(String(house.call("_add_reason", candidate, {candidate: true})).contains("personagem"), "floor placement also rejects player tile"):
		return

	player.global_position = floor.to_global(floor.map_to_local(candidate + Vector2i(1, 0)))
	if not _check(not String(house.call("_player_clearance_reason", candidate)).is_empty(), "one horizontal tile away is protected"):
		return
	player.global_position = floor.to_global(floor.map_to_local(candidate + Vector2i(1, 1)))
	if not _check(not String(house.call("_player_clearance_reason", candidate)).is_empty(), "diagonal one-tile gap is protected"):
		return
	player.global_position = floor.to_global(floor.map_to_local(candidate + Vector2i(2, 0)))
	if not _check(String(house.call("_player_clearance_reason", candidate)).is_empty(), "two tiles away is safe for floor alone"):
		return
	if not _check(String(house.call("_add_reason", candidate, {candidate: true})).contains("personagem"), "automatically generated nearby walls cannot trap player"):
		return
	player.global_position = floor.to_global(floor.map_to_local(candidate + Vector2i(3, 0)))
	if not _check(String(house.call("_add_reason", candidate, {candidate: true})).is_empty(), "building allowed once walls also have safe clearance"):
		return

	# Wall/roof filter: with a preexisting floor, place no target near the actor.
	var saved_footprint: Dictionary = house.get("footprint")
	saved_footprint[candidate] = true
	house.call("_rebuild")
	var nearby_wall: Vector2i = candidate + Vector2i(1, 0)
	player.global_position = floor.to_global(floor.map_to_local(nearby_wall))
	if not _check(String(house.call("_new_construction_reason", saved_footprint, nearby_wall, true)).contains("personagem"), "direct wall and roof placement checks player's cell"):
		return
	if not _check(String(house.call("_spawn_limit_reason", candidate)).is_empty(), "house expansion still respects original spawn"):
		return
	player.global_position = Vector2(6000, 6000)
	if not _check(house.get("_spawn_cell") == spawn, "walking does not move the recorded spawn"):
		return

	print("PASS house-placement: radius, player distance and autogenerated wall safety")
	get_tree().quit(0)
